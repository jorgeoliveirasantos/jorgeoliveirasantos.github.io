<app-container style="padding: 5px; gap: 5px; height: fit-content;">
    <card-big class="no-elastic no-hover">
        <text-heading>IA & ML</text-heading>
    </card-big>
    <horizontal-divider></horizontal-divider>
    <card-big class="no-elastic no-hover" style="padding: 0;">
        <acacia-tabs>
            <acacia-tabs-item id="learn-tab">📝</acacia-tabs-item>
            <acacia-tabs-item id="chat-tab" class="active">💬</acacia-tabs-item>
            <acacia-tabs-item id="train-tab">💪</acacia-tabs-item>
        </acacia-tabs>
        <card-big class="no-elastic no-hover">
            <horizontal-divider></horizontal-divider>
            <text-subheading style="justify-content: start;">Chat com a IA</text-subheading>

            <style>
                .acacia-chat {
                    display: flex;
                    flex-direction: column;
                    gap: 16px;
                    width: 100%;
                    min-height: 540px;
                    max-width: 960px;
                    margin: 0 auto;
                    padding: 20px;
                    border-radius: 32px;
                    box-shadow: 0 25px 60px rgba(15, 23, 42, 0.14);
                    border: 1px solid rgba(15, 23, 42, 0.06);
                }

                .chat-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 12px;
                    padding: 16px 18px;
                    border-radius: 26px;
                    border: 1px solid rgba(15, 23, 42, 0.08);
                }

                .messages {
                    flex: 1;
                    overflow: auto;
                    padding: 20px;
                    display: flex;
                    flex-direction: column;
                    gap: 14px;
                    border-radius: 5px;
                    box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.05);
                }

                .message {
                    max-width: 78%;
                    display: flex;
                    flex-direction: column;
                    gap: 10px;
                    padding: 14px 18px;
                    border-radius: 5px;
                    line-height: 1.5;
                    word-break: break-word;
                }

                .message.user {
                    align-self: flex-end;
                    border-radius: 25px;
                    border-bottom-right-radius: 0;
                    border: none;
                    background: #2d3748;
                    border: none;
                }

                .message.bot {
                    align-self: flex-start;
                    border-radius: 25px;
                    border-bottom-left-radius: 0;
                    background: #2d3748;
                    border: none;
                }

                .message strong {
                    letter-spacing: 0.02em;
                    opacity: 0.88;
                }

                .bubble {
                    display: inline-block;
                    padding: 14px 16px;
                    border-radius: 22px;
                    line-height: 1.45;
                    white-space: pre-wrap;
                    word-break: break-word;
                }

                .user-bubble {
                    background: #374151;
                    color: #f8fafc;
                }

                .bot-bubble {
                    background: #374151;
                    color: #f8fafc;
                }

                .composer {
                    display: flex;
                    gap: 10px;
                    align-items: center;
                    padding-top: 10px;
                    border-top: 1px solid rgba(255, 255, 255, 0.08);
                    background: transparent;
                    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
                }

                .composer .acacia-input {
                    flex: 1;
                    min-height: 72px;
                    max-height: 180px;
                    resize: vertical;
                    padding: 14px 18px;
                    border-radius: 24px;
                    border: 1px solid rgba(15, 23, 42, 0.12);
                    box-shadow: inset 0 1px 3px rgba(15, 23, 42, 0.08);
                    font-size: 0.95rem;
                }

                #sendBtn {
                    padding: 5px;
                    font-size: 1.2rem;
                    aspect-ratio: 1;
                    width: 60px;
                    height: 60px;
                    color: #fff;
                    display: grid;
                    place-items: center;
                    font-weight: bold;
                    border-radius: 9999px;
                    background: var(--DarkGreen);
                    box-shadow: 0 12px 24px rgba(37, 99, 235, 0.18);
                }

                @media (max-width:700px) {
                    .acacia-chat {
                        min-height: 440px;
                        padding: 16px;
                    }

                    .messages {
                        padding: 16px;
                    }

                    .message {
                        max-width: 100%;
                    }

                    .composer {
                        flex-direction: column;
                        align-items: stretch;
                    }

                    #sendBtn {
                        width: 100%;
                    }
                }
            </style>

            <div class="acacia-chat" role="region" aria-label="Chat com a IA">
                <div class="chat-header">
                    <text-link style="text-align: right;">Como conversar com a IA?</text-link>
                    <text-link id="clearConversation">Limpar conversa</text-link>
                </div>

                <div class="messages" id="chatMessages" aria-live="polite">
                    <div class="message bot"><strong style="color: #10b981;">Kaatan Bot</strong>: Olá! Escreva sua mensagem abaixo e pressione "Enviar".</div>
                </div>

                <form class="composer" onsubmit="return false;">
                    <textarea id="chatInput" class="acacia-input" placeholder="Escreva sua mensagem..." aria-label="Mensagem" style="border-radius: 5px; resize: vertical;" rows="5"></textarea>
                    <button-squared id="sendBtn" type="submit">⌯⌲</button-squared>
                </form>
            </div>

            <horizontal-divider></horizontal-divider>
        </card-big>
    </card-big>
</app-container>